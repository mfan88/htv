# Copy to .env. Only HTV_TOKEN is required.
HTV_TOKEN=change-me-to-a-long-random-string
# Keep only these teams' games warm (comma-separated name fragments); empty = every game.
HTV_PRIORITY_TEAMS=
# Thumbnails folder (AWAY_vs_HOME.png files), optional.
# HTV_LOGOS=./logos
# Public address mapping for IPTV apps: "<your source hostname>=<your MediaMTX HLS URL>"
# HTV_EDGE_PUBLIC=
# Public hostname of the WebRTC page, if you expose it (leave empty on a LAN).
# HTV_RTC_HOST=
